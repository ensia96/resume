---
import PrintButton from '@/components/PrintButton.astro';
import SectionNav from '@/components/SectionNav.astro';
import { siteConfig } from '@/config/site';
import '@/styles/screen.css';
import '@/styles/print.css';
interface Props {
  sections: { id: string; title: string }[];
  source: { mode: string; sha: string | null; dirty: boolean | null };
}
const { sections, source } = Astro.props;
const canonical = new URL(import.meta.env.BASE_URL, siteConfig.siteURL);
---
<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteConfig.title}</title>
    <meta name="description" content={siteConfig.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={siteConfig.ogType} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:title" content={siteConfig.title} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:url" content={canonical} />
    {source.sha && <meta name="resume-content-sha" content={source.sha} />}
    <meta name="resume-content-source" content={source.mode} />
    {source.dirty && <meta name="resume-content-dirty" content="true" />}
  </head>
  <body>
    <a class="skip-link" href="#resume-content">본문으로 이동</a>
    <div class="resume-shell">
      <header class="page-header">
        <div><p class="eyebrow">RESUME</p><h1>최호준 <span>이력서</span></h1></div>
        <PrintButton />
      </header>
      <SectionNav sections={sections} />
      <main id="resume-content" tabindex="-1"><slot /></main>
      <footer class="page-footer">
        <p>PDF 파일은 “인쇄 / PDF 저장”에서 브라우저의 “PDF로 저장”을 선택해 만들 수 있습니다.</p>
        {source.sha && <p class="source-note">문서 출처 <code title={source.sha}>{source.sha.slice(0, 12)}</code>{source.dirty ? ' · 로컬 문서 변경 포함' : ''}</p>}
      </footer>
    </div>
  </body>
</html>
