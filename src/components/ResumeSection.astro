---
interface Props {
  section: { id: string; order: number; title: string; date?: string; html: string };
}
const { section } = Astro.props;
---
<section class="resume-section" id={section.id} aria-labelledby={`${section.id}-title`}>
  <header class="section-header">
    <h2 id={`${section.id}-title`}><a href={`#${section.id}`}><span class="section-number" aria-hidden="true">{String(section.order).padStart(2, '0')}</span>{section.title}</a></h2>
    {section.date && <dl class="section-dates">
      <div><dt>문서 기준일</dt><dd><time datetime={section.date.replace(' ', 'T')}>{section.date.slice(0, 10).replaceAll('-', '.')}</time></dd></div>
    </dl>}
  </header>
  <div class="prose" set:html={section.html} />
</section>
